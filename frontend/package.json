{
  "name": "rr7-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run typecheck && bun run lint",
    "typegen": "bun run typegen:iclass && bun run typegen:auth",
    "typegen:iclass": "pg-to-ts generate -c $DATABASE_URL -s iclass -o app/definitions/database.iclass.types.ts",
    "typegen:auth": "pg-to-ts generate -c $DATABASE_URL -s auth -o app/definitions/database.auth.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.39",
    "jose": "^6.2.3",
    "lucide-react": "^1.11.0",
    "nunjucks": "^3.2.4",
    "pdf-signer": "../../pdf-signer-1.0.0.tgz",
    "pg-to-ts": "^4.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "resend": "^6.12.2",
    "rml2pdf": "../../rml2pdf-1.0.0.tgz",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "^7.14.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.23",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
