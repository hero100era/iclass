{
  "name": "rr7-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "verify": "bun run typecheck && bun run lint",
    "typegen": "bun run typegen:iclass && bun run typegen:auth",
    "typegen:iclass": "pg-to-ts generate -c $DATABASE_URL -s iclass -o app/definitions/database.iclass.types.ts",
    "typegen:auth": "pg-to-ts generate -c $DATABASE_URL -s auth -o app/definitions/database.auth.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@react-router/node": "^7.14.1",
    "@react-router/serve": "^7.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.38",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "nunjucks": "^3.2.4",
    "pg-to-ts": "^4.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1",
    "resend": "^4.8.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "^7.14.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "baseline-browser-mapping": "^2.10.18",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
